{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "rootDir": "ts",
    "outDir": "js",
    "strict": false,
    "noImplicitAny": false,
    "sourceMap": false,
    "esModuleInterop": true
  },
  "include": ["ts/**/*.ts"]
}
